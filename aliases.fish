# Google Calendar aliases
abbr --add gcal "gcalcli --calendar='scottrych@gmail.com' --calendar='Family' --details title"
abbr --add agenda "gcalcli --calendar='scottrych@gmail.com' --calendar='Family' agenda"
abbr --add week "gcalcli --calendar='scottrych@gmail.com' --calendar='Family' calw"

# Notification aliases
abbr --add notify "ntf send --pushover.priority normal"
abbr --add notify-low "ntf send --pushover.priority low"
abbr --add notify-high "ntf send --pushover.priority high"
abbr --add notify-done "ntf done"

# Utility aliases
abbr --add ll "ls -la"
abbr --add la "ls -la"
abbr --add .. "cd .."
abbr --add ... "cd ../.."

# Git aliases
abbr --add gs "git status"
abbr --add ga "git add"
abbr --add gc "git commit"
abbr --add gp "git push"
abbr --add gl "git log --oneline"
